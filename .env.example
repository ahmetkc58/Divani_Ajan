# Varsayılan "bm25" çevrimdışı demo akışını korur. Jina + Qdrant için hybrid yapın.
KARAYOL_RETRIEVAL_MODE=bm25

# Varsayılan verified_public kapısını korur. Repodaki sabit 8-belgeli yarışma
# snapshot'ı için competition_snapshot seçin; bu mod güncellik/yürürlük iddiası
# taşımaz ve ayrı corpus/koleksiyon kullanır.
KARAYOL_CORPUS_MODE=verified_public
KARAYOL_COMPETITION_SNAPSHOT_PATH=data/processed/competition_snapshot.json
# Varsayılan reviewed_only yalnız elle incelenmiş yol/levha profillerini kabul
# eder. Geniş UAB arşivini keşif amaçlı test ederken lexical_overlap seçilebilir.
KARAYOL_SNAPSHOT_RELEVANCE_POLICY=reviewed_only

# İnsan onayından geçmiş public legislation corpus JSON yolu.
KARAYOL_ACTIVE_LEGISLATION_PATH=data/processed/active_legislation.json

# Yüklenen PDF/OCR kaynak sınırları. Zayıf sayfa boş OCR verirse belge
# eksik işlenmez; işlem fail-closed durur.
KARAYOL_MAX_PDF_PAGES=50
KARAYOL_MAX_OCR_PIXELS_PER_PAGE=20000000
KARAYOL_MAX_OCR_TOTAL_PIXELS=100000000
KARAYOL_OCR_DOCUMENT_TIMEOUT_SECONDS=120
KARAYOL_OCR_PAGE_TIMEOUT_SECONDS=60

# Jina model ağırlığı ve ayrı auto_map kod deposu kendi commit'lerine pinli.
KARAYOL_EMBEDDING_REVISION=ab036b023d30b4d1138c4c3bfa9f0c445ab455d6
KARAYOL_EMBEDDING_CODE_REVISION=bd55a5ec8e6c0fb1d6c26efb4b6a4a74ce8a88d3
KARAYOL_EMBEDDING_DIMENSION=1024
KARAYOL_EMBEDDING_BATCH_SIZE=16
KARAYOL_EMBEDDING_BACKEND=transformers
KARAYOL_EMBEDDING_LOCAL_FILES_ONLY=false
# CPU için cpu; NVIDIA CUDA GPU için cuda:0.
KARAYOL_EMBEDDING_DEVICE=

# Qdrant bağlantısı. API anahtarını repoya yazmayın.
# Kalıcı gömülü yerel mod için QDRANT_URL'yi kaldırıp örneğin
# KARAYOL_QDRANT_PATH=runtime/qdrant-local kullanın. İkisi aynı anda verilemez.
QDRANT_URL=http://localhost:6333
KARAYOL_QDRANT_PATH=
QDRANT_API_KEY=
KARAYOL_QDRANT_COLLECTION=legal_chunks_v1
KARAYOL_QDRANT_TIMEOUT_SECONDS=10
KARAYOL_INDEX_VERSION=1.0

# Hibrit retrieval başlangıç ayarları.
KARAYOL_HYBRID_CANDIDATE_TOP_K=20
KARAYOL_RRF_K=60
# Dense-only kanıtın kabulü için Jina cosine alt sınırı; RRF skoru bunun yerine geçmez.
KARAYOL_MIN_RETRIEVAL_SCORE=0.20
KARAYOL_RERANKER_REVISION=9cfeff2df7d40d1b78e75e5e9cebec92a99813c9
KARAYOL_RERANKER_CODE_REVISION=9cfeff2df7d40d1b78e75e5e9cebec92a99813c9
KARAYOL_RERANKER_BATCH_SIZE=8
KARAYOL_RERANKER_CANDIDATE_TOP_K=30

# Varsayılan yapılandırılmış LLM katmanı yerel Ollama'dır. API anahtarı
# gerekmez; URL güvenlik nedeniyle yalnız loopback olabilir. Bu makinede kurulu
# küçük completion modeli qwen2.5:0.5b'dir. Daha güçlü yerel model kurarsanız
# yalnız KARAYOL_LLM_MODEL değerini değiştirin.
KARAYOL_LLM_PROVIDER=ollama
KARAYOL_LLM_ENABLED=true
KARAYOL_LLM_MODEL=qwen2.5:0.5b
KARAYOL_LAYER3_ENABLED=true
KARAYOL_LAYER3_LLM_MODEL=llm-fast
KARAYOL_LAYER3_REASONING_LLM_MODEL=llm-large
KARAYOL_LLM_BASE_URL=http://127.0.0.1:11434
KARAYOL_LLM_TIMEOUT_SECONDS=1800
KARAYOL_LLM_MAX_OUTPUT_TOKENS=2048
KARAYOL_LLM_TEMPERATURE=0
KARAYOL_LLM_MAX_INPUT_CHARS=120000

# Haricî sağlayıcılar geriye dönük olarak desteklenir. Etkinleştirilecekse
# provider/model/base URL ile ilgili anahtarı yalnız yerel .env'de tanımlayın.
# GEMINI_API_KEY=

# LegalGraphRAG uyarlamasındaki seçici sentetik multi-hop karar desteği.
# Bu graf production hukuk kanıtı değildir ve girdi SHA-256'ları değişirse
# fail-closed devre dışı kalır.
KARAYOL_EVIDENCE_GRAPH_ENABLED=true
KARAYOL_EVIDENCE_GRAPH_PATH=reports/synthetic_evidence_graph_2026-08-24.json
KARAYOL_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
