# Docker içinden macOS ana makinesindeki Ollama'ya erişim.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Yerel backend geliştirmesinde bunun yerine kullanın:
# OLLAMA_BASE_URL=http://127.0.0.1:11434

APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
APP_MAX_UPLOAD_MB=10
APP_MAX_PDF_PAGES=20
APP_JOB_TIMEOUT_SECONDS=180
APP_LOG_LEVEL=INFO
